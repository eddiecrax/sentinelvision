# SentinelVision Environment Variables

# Video source: webcam | file | rtsp
SV_SOURCE=webcam

# Webcam device index
SV_WEBCAM_INDEX=0

# Video file path (when source=file)
SV_VIDEO_PATH=data/videos/test.mp4

# RTSP URL (when source=rtsp)
SV_RTSP_URL=

# Detection
SV_MODEL=yolov8n.pt
SV_CONFIDENCE_THRESHOLD=0.5
SV_DEVICE=cpu

# Risk thresholds (seconds)
SV_TTC_LOW=5.0
SV_TTC_MEDIUM=3.0
SV_TTC_HIGH=1.0

# Display
SV_SHOW_DISPLAY=true
SV_SHOW_FPS=true
SV_SHOW_TRAJECTORIES=true

# Logging
SV_LOG_LEVEL=INFO

# Environment profile
SV_PROFILE=warehouse

# AWS (Phase 10+)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# AWS_DYNAMODB_TABLE=
