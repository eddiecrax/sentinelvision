# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment & Secrets
.env
.env.*
!.env.example
.env.local
*.credentials
*.key
*.pem

# Data (large files)
data/videos/*.mp4
data/videos/*.avi
data/videos/*.mov
data/datasets/
data/incidents.json
data/incidents_*.json
data/clips/*.jpg
data/clips/snapshots/
