# Models & Weights (Excluded from Git)
*.pt
*.onnx
*.engine
yolov8n.pt
models/*.pt
models/*.onnx
!models/.gitkeep

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Docker
.docker/

# Demo videos and generated video outputs
data/videos/*
!data/videos/.gitkeep

# Keep small evaluation result JSON files tracked
!data/evaluation/*.json

# Internal Workspace Notes & Checklists (Private)
notes/
